# ── Infinite Vybeflix — FortPesa donation backend ────────────────
# Copy the real values into your host's environment variables
# (Render/Railway dashboard, or GitHub Secrets if you deploy via Actions).
# NEVER commit a filled-out .env file.

# Your FortPesa API key from the dashboard (starts with pb_live_)
FORTPESA_API_KEY=pb_live_xxxxxxxxxxxxxxxxxxxxxxxx

# The numeric ID of the donation channel from the FortPesa Channels page
FORTPESA_CHANNEL_ID=42

# Your FortPesa webhook signing secret (starts with whsec_)
FORTPESA_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of origins allowed to call this API.
# Use your live site origin in production.
ALLOWED_ORIGIN=https://infinitevybeflix.abrdns.com

# Optional: persist transactions to a JSON file (survives restarts on hosts with disk)
# DATA_FILE=/var/data/donations.json

# Optional tuning
# PORT=8787
# MIN_AMOUNT=1
# MAX_AMOUNT=1000000
# RATE_LIMIT_MAX=8
# RATE_LIMIT_WINDOW_MS=600000
